; ALTar static slip inversion — auto-generated by SlipKit

slipmodel:

    model = altar.models.seismic.static
    model:
        case = /Users/ymagen/slipkit/altar_synthetic_run/case
        patches = 42
        observations = 875
        green_file = green.txt
        data_file = data.txt
        cd_file = cd.txt

        parametersets:

            strikeslip = contiguous
            strikeslip:
                count = 42
                offset = 0
                prior = altar.distributions.gaussian
                prior.mean = 0
                prior.sigma = 1.0

            dipslip = contiguous
            dipslip:
                count = 42
                offset = 42
                prep = altar.models.seismic.moment
                prep:
                    Mw_mean = 2.558693861702804
                    Mw_sigma = 0.2
                    Mu = 30.0
                    area_patches_file = /Users/ymagen/slipkit/altar_synthetic_run/case/areas.txt
                prior = altar.distributions.uniform
                prior.support = (-0.3, 1.0)

    controller:
        sampler = altar.bayesian.metropolis
        archiver:
            output_dir = /Users/ymagen/slipkit/altar_synthetic_run/results
            output_freq = 3

    job:
        chains = 1024
        steps  = 500
